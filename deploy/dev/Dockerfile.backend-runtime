FROM python:3.12-slim-bookworm@sha256:6a0e06f5ba0b373d051aabd3fffb9b873f27f9a2a3a14bcbe37dee6f0e3bbc70
RUN apt-get update && apt-get install -y --no-install-recommends tor gnupg libmagic1 ca-certificates && rm -rf /var/lib/apt/lists/*
COPY backend/requirements/requirements.txt.noble /tmp/requirements.txt
COPY deploy/dev/requirements-postgresql.txt /tmp/requirements-postgresql.txt
RUN pip install --no-cache-dir --require-hashes -r /tmp/requirements.txt && pip install --no-cache-dir -r /tmp/requirements-postgresql.txt
ENV PYTHONPATH=/app/backend PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app/backend
